    "allow": [
      "Shell(npm *)",
      "Shell(git *)",
      "Shell(node *)",
      "Shell(npx *)",
      "Shell(electron *)",
      "Shell(electron-forge *)",
      "Shell(ls *)",
      "Shell(cat *)",
